rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read porras and their apuestas (public classification)
    match /porras/{porraId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
      );

      match /apuestas/{userId} {
        allow read: if true;
        allow create: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.teams.size() == 10
                      && request.resource.data.totalValue <= 115;
        // No updates — bets are immutable
        allow update: if false;
        allow delete: if false;
      }

      match /predicciones/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // Users collection — only the user can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
